{
  "name": "hrscreen",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[web,pdf,dev]'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "hrscreen web UI (run: hrscreen web)",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
