# environments / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# data/ is ignored (web database, secret key, embedding cache, synthetic files, other downloads)
# EXCEPT the public Resume Atlas dataset (MIT licence), kept at data/raw/resume-atlas/
data/*
!data/raw/
data/raw/*
!data/raw/resume-atlas/
data/raw/resume-atlas/.cache/
models_cache/
*.log

# the source proposal PDF carries a student's name + enrollment number; repo is public
*.pdf
# ...except the fictional sample resumes the web UI ships (no personal data in them)
!src/hrscreen/web/samples/resumes/*.pdf

# local scratch
.playwright-cache/
screenshots/
